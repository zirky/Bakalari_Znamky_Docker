# Aplikace
APP_ENV=production

# Databaze (SQLite, cesta uvnitr kontejneru)
DATABASE_URL=sqlite:////data/app.db

# CORS - oddelit carkou bez mezer
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# Prihlaseni rodice (PIN - pouze cifry)
PARENT_PIN=zmente_tento_pin

# Bakalari API
BAKALARI_BASE_URL=https://vase-skola.bakalari.cz
BAKALARI_USERNAME=
BAKALARI_PASSWORD=

# LNbits
# Adresa vasi LNbits instance (bez lomitka na konci)
LNBITS_HOST=https://legend.lnbits.com
# Invoice/withdraw klic vaseho LNbits penezenkoveho uctu
LNBITS_API_KEY=
# Withdraw klic (pokud se lisi od API klice)
LNBITS_WITHDRAW_KEY=
